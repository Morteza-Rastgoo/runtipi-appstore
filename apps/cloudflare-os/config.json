{
  "$schema": "../app-info-schema.json",
  "name": "Cloudflare OS",
  "available": true,
  "exposable": true,
  "dynamic_config": true,
  "port": 8787,
  "id": "cloudflare-os",
  "tipi_version": 1,
  "version": "1.0.0",
  "categories": ["ai", "development"],
  "description": "Cloudflare OS — an operating system for AI productivity: agent chat, sandboxed app development (gadgets), and capability-based security (Gatekeepers). This self-hosted build runs the full stack (frontend + backend + all Gatekeeper Workers) in a single workerd container on port 8787, with persistent state and OAuth credentials supplied as app settings.",
  "short_desc": "An operating system for AI: agents, gadgets, and Gatekeepers",
  "author": "Morteza Rastgoo",
  "source": "https://github.com/cloudflare/cloudflare-os",
  "website": "https://flare.hellodelorus.com",
  "form_fields": [
    {
      "type": "text",
      "label": "Public Origin",
      "hint": "Full origin the app is served from (scheme + host, no trailing slash). Drives every Gatekeeper's OAuth redirect URI and the connect-handoff origin. Must match the URL the browser actually uses.",
      "env_variable": "PUBLIC_ORIGIN",
      "required": true,
      "default": "https://flare.hellodelorus.com"
    },
    {
      "type": "text",
      "label": "Login Gatekeepers",
      "hint": "Comma-separated vendor ids to offer as 'Continue with ...' login buttons (e.g. google,github). Leave empty for password-only login.",
      "env_variable": "AUTH_GATEKEEPERS",
      "required": false
    },
    { "type": "text", "label": "Google Client ID", "env_variable": "GOOGLE_CLIENT_ID", "required": false },
    { "type": "password", "label": "Google Client Secret", "env_variable": "GOOGLE_CLIENT_SECRET", "required": false },
    { "type": "text", "label": "GitHub Client ID", "env_variable": "GITHUB_CLIENT_ID", "required": false },
    { "type": "password", "label": "GitHub Client Secret", "env_variable": "GITHUB_CLIENT_SECRET", "required": false },
    { "type": "text", "label": "GitLab Client ID", "env_variable": "GITLAB_CLIENT_ID", "required": false },
    { "type": "password", "label": "GitLab Client Secret", "env_variable": "GITLAB_CLIENT_SECRET", "required": false },
    { "type": "text", "label": "Cloudflare OAuth Client ID", "env_variable": "CLOUDFLARE_OAUTH_CLIENT_ID", "required": false },
    { "type": "password", "label": "Cloudflare OAuth Client Secret", "env_variable": "CLOUDFLARE_OAUTH_CLIENT_SECRET", "required": false },
    { "type": "text", "label": "Linear Client ID", "env_variable": "LINEAR_CLIENT_ID", "required": false },
    { "type": "password", "label": "Linear Client Secret", "env_variable": "LINEAR_CLIENT_SECRET", "required": false },
    { "type": "text", "label": "Notion Client ID", "env_variable": "NOTION_CLIENT_ID", "required": false },
    { "type": "password", "label": "Notion Client Secret", "env_variable": "NOTION_CLIENT_SECRET", "required": false },
    { "type": "text", "label": "Spotify Client ID", "env_variable": "SPOTIFY_CLIENT_ID", "required": false },
    { "type": "password", "label": "Spotify Client Secret", "env_variable": "SPOTIFY_CLIENT_SECRET", "required": false },
    { "type": "text", "label": "Supabase Client ID", "env_variable": "SUPABASE_CLIENT_ID", "required": false },
    { "type": "password", "label": "Supabase Client Secret", "env_variable": "SUPABASE_CLIENT_SECRET", "required": false }
  ],
  "supported_architectures": ["amd64"],
  "created_at": 1794765813276,
  "updated_at": 1794765813276
}
