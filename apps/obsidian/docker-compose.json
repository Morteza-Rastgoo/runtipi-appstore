{
  "services": [
    {
      "name": "obsidian",
      "image": "lscr.io/linuxserver/obsidian:1.15.0",
      "isMain": true,
      "internalPort": 3001,
      "environment": [
        {
          "key": "PUID",
          "value": "1000"
        },
        {
          "key": "PGID",
          "value": "1000"
        },
        {
          "key": "TZ",
          "value": "UTC"
        }
      ],
      "volumes": [
        {
          "hostPath": "${ROOT_FOLDER_HOST}/media/data/obsidian",
          "containerPath": "/config"
        }
      ],
      "shm_size": "1gb"
    }
  ]
}