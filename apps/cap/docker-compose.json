{
  "services": {
    "cap": {
      "image": "ghcr.io/capsoftware/cap-web:latest",
      "container_name": "cap-web",
      "restart": "unless-stopped",
      "depends_on": {
        "cap-mysql": {
          "condition": "service_healthy"
        },
        "cap-minio": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "DATABASE_URL": "mysql://cap:${MYSQL_PASSWORD:-cap-local-pwd-123}@cap-mysql:3306/cap",
        "WEB_URL": "https://${APP_DOMAIN}",
        "NEXTAUTH_URL": "https://${APP_DOMAIN}",
        "DATABASE_ENCRYPTION_KEY": "${DATABASE_ENCRYPTION_KEY}",
        "NEXTAUTH_SECRET": "${NEXTAUTH_SECRET}",
        "MEDIA_SERVER_WEBHOOK_SECRET": "${MEDIA_SERVER_WEBHOOK_SECRET}",
        "CAP_AWS_ACCESS_KEY": "${MINIO_ROOT_USER:-cap-admin}",
        "CAP_AWS_SECRET_KEY": "${MINIO_ROOT_PASSWORD:-cap-minio-pwd-456}",
        "CAP_AWS_BUCKET": "cap",
        "CAP_AWS_REGION": "us-east-1",
        "S3_PUBLIC_ENDPOINT": "https://${APP_DOMAIN}",
        "S3_INTERNAL_ENDPOINT": "http://cap-minio:9000",
        "S3_PATH_STYLE": "true",
        "MEDIA_SERVER_URL": "http://cap-media-server:3456",
        "MEDIA_SERVER_WEBHOOK_URL": "http://cap-web:3000"
      },
      "ports": [
        "${APP_PORT}:3000"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "-O",
          "/dev/null",
          "http://127.0.0.1:3000/"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3,
        "start_period": "60s"
      },
      "labels": {
        "traefik.enable": "true",
        "traefik.http.routers.cap.rule": "Host(`${APP_DOMAIN}`)",
        "traefik.http.routers.cap.entrypoints": "websecure",
        "traefik.http.routers.cap.tls.certresolver": "myresolver",
        "traefik.http.routers.cap.middlewares": "runtipi",
        "traefik.http.services.cap.loadbalancer.server.port": "3000",
        "traefik.http.middlewares.cap-noindex.headers.customResponseHeaders.X-Robots-Tag": "noindex, nofollow",
        "traefik.http.services.cap.middlewares": "cap-noindex",
        "runtipi.managed": "true"
      },
      "x-runtipi": {
        "is_main": true,
        "internal_port": 3000
      },
      "networks": [
        "tipi_main_network"
      ]
    },
    "cap-media-server": {
      "image": "ghcr.io/capsoftware/cap-media-server:latest",
      "container_name": "cap-media-server",
      "restart": "unless-stopped",
      "environment": {
        "PORT": "3456",
        "MEDIA_SERVER_WEBHOOK_SECRET": "${MEDIA_SERVER_WEBHOOK_SECRET}"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "bun",
          "-e",
          "fetch('http://127.0.0.1:3456/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3,
        "start_period": "10s"
      },
      "networks": [
        "tipi_main_network"
      ]
    },
    "cap-mysql": {
      "image": "mysql:8.0",
      "container_name": "cap-mysql",
      "restart": "unless-stopped",
      "environment": {
        "MYSQL_DATABASE": "cap",
        "MYSQL_USER": "cap",
        "MYSQL_PASSWORD": "${MYSQL_PASSWORD:-cap-local-pwd-123}",
        "MYSQL_ROOT_PASSWORD": "${MYSQL_ROOT_PASSWORD:-cap-root-pwd-789}"
      },
      "command": [
        "--max_connections=1000",
        "--default-authentication-plugin=mysql_native_password",
        "--character-set-server=utf8mb4",
        "--collation-server=utf8mb4_unicode_ci"
      ],
      "volumes": [
        "cap-mysql-data:/var/lib/mysql"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "mysqladmin",
          "ping",
          "-h",
          "localhost",
          "-u",
          "cap",
          "-p${MYSQL_PASSWORD:-cap-local-pwd-123}"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 10,
        "start_period": "30s"
      },
      "networks": [
        "tipi_main_network"
      ]
    },
    "cap-minio": {
      "image": "minio/minio:latest",
      "container_name": "cap-minio",
      "restart": "unless-stopped",
      "command": "server /data --console-address \":9001\"",
      "environment": {
        "MINIO_ROOT_USER": "${MINIO_ROOT_USER:-cap-admin}",
        "MINIO_ROOT_PASSWORD": "${MINIO_ROOT_PASSWORD:-cap-minio-pwd-456}"
      },
      "volumes": [
        "cap-minio-data:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "mc",
          "ready",
          "local"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3,
        "start_period": "10s"
      },
      "networks": [
        "tipi_main_network"
      ]
    },
    "cap-minio-setup": {
      "image": "minio/mc:latest",
      "container_name": "cap-minio-setup",
      "restart": "no",
      "depends_on": {
        "cap-minio": {
          "condition": "service_healthy"
        }
      },
      "entrypoint": [
        "/bin/sh",
        "-c",
        "mc alias set capminio http://cap-minio:9000 $${MINIO_ROOT_USER:-cap-admin} $${MINIO_ROOT_PASSWORD:-cap-minio-pwd-456}; mc mb capminio/cap --ignore-existing; exit 0;"
      ],
      "environment": {
        "MINIO_ROOT_USER": "${MINIO_ROOT_USER:-cap-admin}",
        "MINIO_ROOT_PASSWORD": "${MINIO_ROOT_PASSWORD:-cap-minio-pwd-456}"
      },
      "networks": [
        "tipi_main_network"
      ]
    }
  },
  "volumes": {
    "cap-mysql-data": {
      "driver": "local"
    },
    "cap-minio-data": {
      "driver": "local"
    }
  },
  "networks": {
    "tipi_main_network": {
      "name": "runtipi_tipi_main_network",
      "external": true
    }
  }
}
