  "description": "Cap is an open-source, self-hosted screen-recording and video-sharing platform. Record your screen, add captions, and share. A self-hosted alternative to Loom.",
  "short_desc": "Self-hosted screen & video recording — a Loom alternative",
  "author": "Mohammad Reza Rastgoo",
  "source": "https://github.com/capsoftware/cap",
  "website": "https://cap.so/",
  "form_fields": [
    {
      "type": "random",
      "label": "NextAuth Secret",
      "min": 32,
      "env_variable": "NEXTAUTH_SECRET"
    },
    {
      "type": "random",
      "label": "Database Encryption Key",
      "min": 64,
      "env_variable": "DATABASE_ENCRYPTION_KEY"
    },
    {
      "type": "random",
      "label": "Media Server Webhook Secret",
      "min": 32,
      "env_variable": "MEDIA_SERVER_WEBHOOK_SECRET"
    },
    {
      "type": "text",
      "label": "MySQL Password",
      "env_variable": "MYSQL_PASSWORD",
      "required": true,
      "default": "cap-local-pwd-123"
    }
  ],
  "supported_architectures": [
    "arm64",
    "amd64"
