{
  "services": {
    "openproject": {
      "image": "openproject/openproject:17.9.7",
      "container_name": "openproject",
      "restart": "unless-stopped",
      "environment": {
        "OPENPROJECT_HOST": "${APP_DOMAIN}",
        "OPENPROJECT_SECRET_KEY_BASE": "${OPENPROJECT_SECRET_KEY_BASE}"
      },
      "ports": [
        "${APP_PORT}:80"
      ],
      "volumes": [
        "openproject-data:/var/opt/openproject/data"
      ],
      "labels": {
        "traefik.enable": "true",
        "traefik.http.routers.openproject.rule": "Host(`${APP_DOMAIN}`)",
        "traefik.http.routers.openproject.entrypoints": "websecure",
        "traefik.http.routers.openproject.tls.certresolver": "myresolver",
        "traefik.http.routers.openproject.middlewares": "runtipi",
        "traefik.http.services.openproject.loadbalancer.server.port": "80",
        "traefik.http.middlewares.openproject-noindex.headers.customResponseHeaders.X-Robots-Tag": "noindex, nofollow",
        "traefik.http.services.openproject.middlewares": "openproject-noindex",
        "runtipi.managed": "true"
      },
      "x-runtipi": {
        "is_main": true,
        "internal_port": 80
      },
      "networks": [
        "tipi_main_network"
      ]
    }
  },
  "volumes": {
    "openproject-data": {
      "driver": "local"
    }
  },
  "networks": {
    "tipi_main_network": {
      "name": "runtipi_tipi_main_network",
      "external": true
    }
  }
}
