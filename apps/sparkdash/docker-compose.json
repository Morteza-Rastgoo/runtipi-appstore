{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "sparkdash",
      "image": "127.0.0.1:5000/sparkdash:local",
      "isMain": true,
      "internalPort": 5555,
      "restart": "unless-stopped",
      "privileged": true,
      "pid": "host",
      "extraHosts": [
        "host.docker.internal:host-gateway"
      ],
      "environment": [
        { "key": "PORT", "value": "5555" },
        { "key": "BIND_HOST", "value": "0.0.0.0" },
        { "key": "SPARKDASH_TOKEN", "value": "${SPARKDASH_TOKEN:-}" },
        { "key": "TZ", "value": "${TZ}" }
      ],
      "volumes": [
        { "hostPath": "/proc", "containerPath": "/host/proc", "readOnly": true },
        { "hostPath": "/sys", "containerPath": "/host/sys", "readOnly": true },
        { "hostPath": "/", "containerPath": "/host/root", "readOnly": true },
        { "hostPath": "/usr/bin/nvidia-smi", "containerPath": "/usr/bin/nvidia-smi", "readOnly": true },
        { "hostPath": "/usr/lib/x86_64-linux-gnu/libnvidia-ml.so.1", "containerPath": "/usr/lib/x86_64-linux-gnu/libnvidia-ml.so.1", "readOnly": true },
        { "hostPath": "${APP_DATA_DIR}/config", "containerPath": "/app/config" }
      ],
      "healthCheck": {
        "test": "node -e \"fetch('http://127.0.0.1:5555/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
        "interval": "30s",
        "timeout": "10s",
        "retries": 3,
        "startPeriod": "30s"
      },
      "extraLabels": {
        "traefik.http.middlewares.{{RUNTIPI_APP_ID}}-noindex.headers.customResponseHeaders.X-Robots-Tag": "noindex, nofollow",
        "traefik.http.services.{{RUNTIPI_APP_ID}}.middlewares": "{{RUNTIPI_APP_ID}}-noindex"
      }
    }
  ]
}
