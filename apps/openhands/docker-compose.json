{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "openhands",
      "image": "ghcr.io/openhands/agent-canvas:1.41.0",
      "isMain": true,
      "internalPort": 8000,
      "user": "1000:1000",
      "restart": "unless-stopped",
      "environment": [
        { "key": "HOME", "value": "/home/openhands" },
        { "key": "XDG_CONFIG_HOME", "value": "/home/openhands/.openhands/config" },
        { "key": "AGENT_CANVAS_BASE_PATH", "value": "/" },
        { "key": "TZ", "value": "${TZ}" }
      ],
      "volumes": [
        { "hostPath": "/home/morteza/.openhands", "containerPath": "/home/openhands/.openhands" },
        { "hostPath": "/home/morteza/projects", "containerPath": "/projects" },
        { "hostPath": "/home/morteza/Android/Sdk", "containerPath": "/opt/android-sdk" }
      ],
      "extraLabels": {
        "traefik.http.middlewares.{{RUNTIPI_APP_ID}}-noindex.headers.customResponseHeaders.X-Robots-Tag": "noindex, nofollow",
        "traefik.http.services.{{RUNTIPI_APP_ID}}.middlewares": "{{RUNTIPI_APP_ID}}-noindex"
      }
    }
  ]
}
