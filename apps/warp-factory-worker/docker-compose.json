{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "warp-factory-worker",
      "image": "warpdotdev/oz-agent-worker:v2026-11-12-16-17-15",
      "isMain": true,
      "user": "0",
      "restart": "unless-stopped",
      "command": "--worker-id ${WORKER_ID} --config-file /data/worker.yaml ${WARP_EXTRA_ARGS}",
      "environment": [
        { "key": "WARP_API_KEY", "value": "${WARP_API_KEY}" },
        { "key": "WORKER_ID", "value": "${WORKER_ID}" },
        { "key": "TZ", "value": "${TZ}" }
      ],
      "volumes": [
        { "hostPath": "/var/run/docker.sock", "containerPath": "/var/run/docker.sock" },
        { "hostPath": "${APP_DATA_DIR}/data", "containerPath": "/data" }
      ]
    }
  ]
}
