{
  "services": {
    "appflowy": {
      "image": "nginx:alpine",
      "container_name": "appflowy-nginx",
      "restart": "unless-stopped",
      "ports": [
        "${APP_PORT}:80"
      ],
      "volumes": [
        "${APP_DATA_DIR}/data/nginx/nginx.conf:/etc/nginx/nginx.conf:ro"
      ],
      "depends_on": [
        "appflowy_cloud",
        "gotrue",
        "appflowy_web",
        "admin_frontend"
      ],
      "labels": {
        "traefik.enable": "true",
        "traefik.http.routers.appflowy.rule": "Host(`${APP_DOMAIN}`)",
        "traefik.http.routers.appflowy.entrypoints": "websecure",
        "traefik.http.routers.appflowy.tls.certresolver": "myresolver",
        "traefik.http.routers.appflowy.middlewares": "runtipi",
        "traefik.http.services.appflowy.loadbalancer.server.port": "80",
        "traefik.http.middlewares.appflowy-noindex.headers.customResponseHeaders.X-Robots-Tag": "noindex, nofollow",
        "traefik.http.services.appflowy.middlewares": "appflowy-noindex",
        "runtipi.managed": "true"
      },
      "x-runtipi": {
        "is_main": true,
        "internal_port": 80
      },
      "networks": [
        "tipi_main_network"
      ]
    },
    "minio": {
      "image": "minio/minio:latest",
      "container_name": "appflowy-minio",
      "restart": "unless-stopped",
      "command": "server /data --console-address \":9001\"",
      "environment": {
        "MINIO_BROWSER_REDIRECT_URL": "https://${APP_DOMAIN}/minio",
        "MINIO_ROOT_USER": "${APPFLOWY_S3_ACCESS_KEY:-minioadmin}",
        "MINIO_ROOT_PASSWORD": "${APPFLOWY_S3_SECRET_KEY:-minioadmin}"
      },
      "volumes": [
        "appflowy-minio-data:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:9000/minio/health/live"
        ],
        "interval": "30s",
        "timeout": "20s",
        "retries": 3
      },
      "networks": [
        "tipi_main_network"
      ]
    },
    "postgres": {
      "image": "pgvector/pgvector:pg16",
      "container_name": "appflowy-postgres",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_USER": "postgres",
        "POSTGRES_DB": "postgres",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:-password}"
      },
      "volumes": [
        "appflowy-postgres-data:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "postgres",
          "-d",
          "postgres"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 12
      },
      "networks": [
        "tipi_main_network"
      ]
    },
    "redis": {
      "image": "redis:7-alpine",
      "container_name": "appflowy-redis",
      "restart": "unless-stopped",
      "networks": [
        "tipi_main_network"
      ]
    },
    "gotrue": {
      "image": "appflowyinc/gotrue:latest",
      "container_name": "appflowy-gotrue",
      "restart": "unless-stopped",
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "GOTRUE_ADMIN_EMAIL": "${GOTRUE_ADMIN_EMAIL}",
        "GOTRUE_ADMIN_PASSWORD": "${GOTRUE_ADMIN_PASSWORD}",
        "GOTRUE_DISABLE_SIGNUP": "false",
        "GOTRUE_SITE_URL": "appflowy-flutter://",
        "GOTRUE_URI_ALLOW_LIST": "**",
        "GOTRUE_JWT_SECRET": "${GOTRUE_JWT_SECRET}",
        "GOTRUE_JWT_ADMIN_GROUP_NAME": "supabase_admin",
        "GOTRUE_DB_DRIVER": "postgres",
        "API_EXTERNAL_URL": "https://${APP_DOMAIN}",
        "DATABASE_URL": "postgres://postgres:${POSTGRES_PASSWORD:-password}@postgres:5432/postgres",
        "PORT": "9999",
        "GOTRUE_MAILER_AUTOCONFIRM": "true"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl --fail http://127.0.0.1:9999/health || exit 1"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 12,
        "start_period": "40s"
      },
      "networks": [
        "tipi_main_network"
      ]
    },
    "appflowy_cloud": {
      "image": "appflowyinc/appflowy_cloud:latest",
      "container_name": "appflowy-cloud",
      "restart": "unless-stopped",
      "depends_on": {
        "gotrue": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "APPFLOWY_ENVIRONMENT": "production",
        "APPFLOWY_DATABASE_URL": "postgres://postgres:${POSTGRES_PASSWORD:-password}@postgres:5432/postgres",
        "APPFLOWY_REDIS_URI": "redis://redis:6379",
        "APPFLOWY_GOTRUE_JWT_SECRET": "${GOTRUE_JWT_SECRET}",
        "APPFLOWY_GOTRUE_BASE_URL": "http://gotrue:9999",
        "APPFLOWY_S3_CREATE_BUCKET": "true",
        "APPFLOWY_S3_USE_MINIO": "true",
        "APPFLOWY_S3_MINIO_URL": "http://minio:9000",
        "APPFLOWY_S3_ACCESS_KEY": "${APPFLOWY_S3_ACCESS_KEY:-minioadmin}",
        "APPFLOWY_S3_SECRET_KEY": "${APPFLOWY_S3_SECRET_KEY:-minioadmin}",
        "APPFLOWY_S3_BUCKET": "appflowy",
        "APPFLOWY_S3_REGION": "us-east-1",
        "APPFLOWY_S3_PRESIGNED_URL_ENDPOINT": "https://${APP_DOMAIN}",
        "APPFLOWY_BASE_URL": "https://${APP_DOMAIN}",
        "APPFLOWY_WEB_URL": "https://${APP_DOMAIN}",
        "AI_ENABLED": "false"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl --fail http://127.0.0.1:8000/api/health || exit 1"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 12
      },
      "networks": [
        "tipi_main_network"
      ]
    },
    "appflowy_worker": {
      "image": "appflowyinc/appflowy_worker:latest",
      "container_name": "appflowy-worker",
      "restart": "unless-stopped",
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "appflowy_cloud": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "APPFLOWY_ENVIRONMENT": "production",
        "APPFLOWY_WORKER_REDIS_URL": "redis://redis:6379",
        "APPFLOWY_WORKER_ENVIRONMENT": "production",
        "APPFLOWY_WORKER_DATABASE_URL": "postgres://postgres:${POSTGRES_PASSWORD:-password}@postgres:5432/postgres",
        "APPFLOWY_WORKER_DATABASE_NAME": "postgres",
        "APPFLOWY_S3_USE_MINIO": "true",
        "APPFLOWY_S3_MINIO_URL": "http://minio:9000",
        "APPFLOWY_S3_ACCESS_KEY": "${APPFLOWY_S3_ACCESS_KEY:-minioadmin}",
        "APPFLOWY_S3_SECRET_KEY": "${APPFLOWY_S3_SECRET_KEY:-minioadmin}",
        "APPFLOWY_S3_BUCKET": "appflowy",
        "APPFLOWY_S3_REGION": "us-east-1"
      },
      "networks": [
        "tipi_main_network"
      ]
    },
    "appflowy_search": {
      "image": "appflowyinc/appflowy_search:latest",
      "container_name": "appflowy-search",
      "restart": "unless-stopped",
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "APPFLOWY_SEARCH_HOST": "[::]",
        "APPFLOWY_SEARCH_PORT": "4002",
        "APPFLOWY_SEARCH_DATABASE_URL": "postgres://postgres:${POSTGRES_PASSWORD:-password}@postgres:5432/postgres",
        "APPFLOWY_SEARCH_REDIS_URL": "redis://redis:6379",
        "APPFLOWY_S3_USE_MINIO": "true",
        "APPFLOWY_S3_MINIO_URL": "http://minio:9000",
        "APPFLOWY_S3_ACCESS_KEY": "${APPFLOWY_S3_ACCESS_KEY:-minioadmin}",
        "APPFLOWY_S3_SECRET_KEY": "${APPFLOWY_S3_SECRET_KEY:-minioadmin}",
        "APPFLOWY_S3_BUCKET": "appflowy",
        "APPFLOWY_S3_REGION": "us-east-1",
        "APPFLOWY_GOTRUE_JWT_SECRET": "${GOTRUE_JWT_SECRET}"
      },
      "volumes": [
        "appflowy-keyword-index:/var/lib/appflowy/keyword_index"
      ],
      "networks": [
        "tipi_main_network"
      ]
    },
    "appflowy_web": {
      "image": "appflowyinc/appflowy_web:latest",
      "container_name": "appflowy-web",
      "restart": "unless-stopped",
      "depends_on": {
        "appflowy_cloud": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "APPFLOWY_BASE_URL": "https://${APP_DOMAIN}",
        "APPFLOWY_GOTRUE_BASE_URL": "https://${APP_DOMAIN}/gotrue",
        "APPFLOWY_WS_BASE_URL": "https://${APP_DOMAIN}"
      },
      "networks": [
        "tipi_main_network"
      ]
    },
    "admin_frontend": {
      "image": "appflowyinc/admin_frontend:latest",
      "container_name": "appflowy-admin-frontend",
      "restart": "unless-stopped",
      "depends_on": {
        "gotrue": {
          "condition": "service_healthy"
        },
        "appflowy_cloud": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "APPFLOWY_GOTRUE_BASE_URL": "http://gotrue:9999",
        "APPFLOWY_BASE_URL": "http://appflowy_cloud:8000"
      },
      "networks": [
        "tipi_main_network"
      ]
    }
  },
  "volumes": {
    "appflowy-minio-data": {
      "driver": "local"
    },
    "appflowy-postgres-data": {
      "driver": "local"
    },
    "appflowy-keyword-index": {
      "driver": "local"
    }
  },
  "networks": {
    "tipi_main_network": {
      "name": "runtipi_tipi_main_network",
      "external": true
    }
  }
}
